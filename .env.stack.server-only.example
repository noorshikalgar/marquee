# Copy this to `.env` next to docker-compose.server-only.yml (or paste these into
# Portainer's stack "Environment variables" editor) before deploying the stack.
#
# This variant runs the backend API alone — no bundled web frontend. Use it when
# every client is the Marquee desktop app (Tauri), or when you're hosting the
# frontend separately yourself.

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Gemini — official @google/genai SDK, model pinned to gemini-3.6-flash in code
GEMINI_API_KEY=

# Tavily — https://tavily.com
TAVILY_API_KEY=

# Web Push — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Daily digest schedule (cron syntax, server time)
NOTIFICATION_CRON=0 9 * * *

# Every origin allowed to call this API, comma-separated, no trailing slash.
# Desktop (Tauri) clients need their webview origin included:
#   macOS/Linux: tauri://localhost
#   Windows:     https://tauri.localhost
# Add any web frontend origin too, if you're hosting one separately.
# e.g. tauri://localhost,https://tauri.localhost,https://movies.example.com
FRONTEND_ORIGIN=tauri://localhost,https://tauri.localhost

# Host port the backend container publishes — point desktop clients and/or your
# reverse proxy at this.
BACKEND_PORT=8787

# Bootstrap admin account, created on first boot. CHANGE THE PASSWORD — the
# default below is public (it's in this example file) and unsafe on a real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
