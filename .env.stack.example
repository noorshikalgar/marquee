# Copy this to `.env` next to docker-compose.yml (or paste these into Portainer's
# stack "Environment variables" editor) before deploying the stack.

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Gemini — official @google/genai SDK, model pinned to gemini-3.6-flash in code
GEMINI_API_KEY=

# Tavily — https://tavily.com
TAVILY_API_KEY=

# Web Push — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Daily digest schedule (cron syntax, server time)
NOTIFICATION_CRON=0 9 * * *

# The real origin(s) you'll reach this site at, comma-separated, no trailing slash.
# e.g. https://movies.example.com  (add more separated by commas if you use more than one)
FRONTEND_ORIGIN=https://movies.example.com

# Host port the frontend container publishes (point your reverse proxy / DNS at this).
HTTP_PORT=8080

# Bootstrap admin account, created on first boot. CHANGE THE PASSWORD — the
# default below is public (it's in this example file) and unsafe on a real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
